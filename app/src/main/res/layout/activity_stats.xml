<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#04151F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="20dp"
        android:paddingHorizontal="12dp"
        android:background="#0A2230"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:weightSum="3">

        <TextView
            android:id="@+id/tvMainHomeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingHorizontal="4dp"/>

        <LinearLayout
            android:id="@+id/layoutCenterScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvMainScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 - 0"
                android:textColor="#E53935"
                android:textStyle="bold"
                android:textSize="26sp"/>

            <TextView
                android:id="@+id/tvMatchClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#85A2B6"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:gravity="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMainAwayName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingHorizontal="4dp"/>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#04151F"
        app:tabTextColor="#85A2B6"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabIndicatorColor="#E53935"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        android:contentDescription="Μενού Στατιστικών"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLineups"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>