<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#04151F"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnSelectHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A2230"
            app:cornerRadius="12dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:text="0 - 0"
            android:textColor="#E53935"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnSelectAway"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Away"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A2230"
            app:cornerRadius="12dp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvMatchTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#85A2B6"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/tvExtraTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" +00:00"
            android:textColor="#E53935"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutInjuryTimePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0A2230"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️ ΟΡΙΣΜΟΣ ΛΕΠΤΩΝ ΚΑΘΥΣΤΕΡΗΣΕΩΝ:"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/btnInjury1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+1" android:layout_margin="2dp" android:backgroundTint="#163344"/>
            <Button android:id="@+id/btnInjury2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+2" android:layout_margin="2dp" android:backgroundTint="#163344"/>
            <Button android:id="@+id/btnInjury3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+3" android:layout_margin="2dp" android:backgroundTint="#163344"/>
            <Button android:id="@+id/btnInjury4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+4" android:layout_margin="2dp" android:backgroundTint="#163344"/>
            <Button android:id="@+id/btnInjury5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+5" android:layout_margin="2dp" android:backgroundTint="#163344"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSubstitution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 ΠΡΑΓΜΑΤΟΠΟΙΗΣΗ ΑΛΛΑΓΗΣ"
        android:textColor="#FFFFFF"
        android:backgroundTint="#163344"
        app:cornerRadius="8dp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:id="@+id/layoutSummaryChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/containerDynamicButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>