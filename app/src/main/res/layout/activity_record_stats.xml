<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E8F0FE"
            android:padding="15dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvHomeTeamName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Γηπεδούχος"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center"/>

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 - 0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:textColor="#1a73e8"/>

            <TextView
                android:id="@+id/tvAwayTeamName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Φιλοξενούμενος"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Λεπτό Αγώνα:" android:textStyle="bold"/>
        <EditText
            android:id="@+id/etMinute"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:inputType="number"
            android:layout_marginBottom="15dp"
            android:hint="π.χ. 45"
            android:autofillHints="none"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ομάδα Ενέργειας:" android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerTeamSelection"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:contentDescription="Επιλογή Ομάδας"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ενέργεια:" android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerActionType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:contentDescription="Επιλογή Ενέργειας"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Λεπτομέρεια:" android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerActionDetail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:contentDescription="Επιλογή Λεπτομέρειας"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Αποτέλεσμα:" android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerActionResult"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:contentDescription="Επιλογή Αποτελέσματος"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Παίκτης (Εκτελεστής):" android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerPlayer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"
            android:contentDescription="Επιλογή Παίκτη"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ασσίστ (Μόνο στο Γκολ):" android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerAssistPlayer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="25dp"
            android:contentDescription="Επιλογή Ασσίστ"/>

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ΚΑΤΑΓΡΑΦΗ ΣΤΑΤΙΣΤΙΚΟΥ"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"/>

    </LinearLayout>
</ScrollView>